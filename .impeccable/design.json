  "narrative": {
    "northStar": "The Merchant's Counter",
    "overview": "Shiniri is a shop counter at night. The shell is black lacquer with a brass rule under it and Yan, the in-game merchant, behind the counter. The pages below it are account-book paper in light mode and dark lacquer in dark mode, ruled in brass. Every save is a vermilion seal pressed into the book. The name is Yan's word for the player, 新入り (rookie), and the tag sits beside the wordmark.\n\nThe app is still an Operate surface: one column, labels above inputs, 44px targets, a Save bar pinned to the bottom of the screen. The world enters through color, type, icons and one signature move (the seal), never through layout or controls.\n\nYan is a binding brand commitment (PRODUCT.md). She appears as a bust-up portrait in the header and as the smiling banner on the sign-in screen. The wider `yan-burst` art is reserved for a future view-only mode.",
    "keyCharacteristics": [
      "Lacquer shell, paper pages, brass rules, one vermilion seal.",
      "Zen Antique for display only; Zen Kaku Gothic New for everything people read and type.",
      "Light and dark are both first-class, switched by a header button; dark is the lantern-lit shop.",
      "Icons sit on gold-ringed coins beside short labels; the text stays for screen readers.",
      "Phone-first single column, `max-w-xl` centered on desktop."
    ],
    "rules": [
      {
        "name": "The Seal Is The Action Rule",
        "body": "Vermilion marks the one primary action or a selected state. If two vermilion things compete on a screen, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Brass Is Structure Rule",
        "body": "Gold draws rules, rings and the active item. It is never a text fill for body copy.",
        "section": "colors"
      },
      {
        "name": "The Swap Rule",
        "body": "Dark mode swaps cream and charcoal through the `paper` / `ink` shortcuts and flips `--gold` and `--err`. It adds no third page color. The header stays lacquer in both themes.",
        "section": "colors"
      },
      {
        "name": "The Signboard Rule",
        "body": "Zen Antique names things (the app, a page). It never sets a label, an input or a sentence.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Numeric inputs use tabular figures so columns of counts line up.",
        "section": "typography"
      },
      {
        "name": "The Chop Rule",
        "body": "Weight comes from a thicker border edge, never from a drop shadow. No blur, no hard offset shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the `paper`, `ink`, `ink-soft`, `rule`, `rule-ink`, `focus`, `press`, `tap-on`, `btn-save`, `savebar` and `page-title` shortcuts from `uno.config.ts`.",
      "**Do** keep touch targets at 44px or more and Save at 48px.",
      "**Do** keep pages sparse: one column, labels above inputs.",
      "**Do** honor `prefers-reduced-motion`, and keep text beside every icon in the markup.",
      "**Do** check any new color in both themes; gold and error have separate light and dark values."
    ],
    "donts": [
      "**Don't** use Zen Antique for labels, inputs or running text.",
      "**Don't** add drop shadows, blur or gradients for depth; use a border edge.",
      "**Don't** use vermilion as decoration or on more than one primary action per screen.",
      "**Don't** introduce a third page color in dark mode.",
      "**Don't** list logged history on form pages; that belongs to a future dashboard."
    ]
  }
